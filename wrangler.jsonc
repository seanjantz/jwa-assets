// Cloudflare settings for the Jantz Wealth Advisors site.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "jwa-site",
  "compatibility_date": "2026-11-01",
  // Runs before every deploy: assembles the pages into ./dist
  "build": { "command": "node build.mjs" },
  // The small program that receives the Schedule form and emails it to the firm
  "main": "worker/index.js",
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
